# PostgreSQL
POSTGRES_DB=fortigate_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

# App environment
ASPNETCORE_ENVIRONMENT=Production
FRONTEND_ORIGIN=http://localhost:8081

# Microsoft Entra ID (Azure AD)
#AZURE_AD_TENANT_ID=
#AZURE_AD_API_CLIENT_ID=
#AZURE_AD_SPA_CLIENT_ID=
AZURE_AD_API_SCOPE=access_as_user

# FortiGate Cloud API credentials (never commit real values)
FORTIGATE_CLOUD_CLIENT_ID=
FORTIGATE_CLOUD_CLIENT_SECRET=
FORTIGATE_CLOUD_USERNAME=
FORTIGATE_CLOUD_PASSWORD=

# Notification integrations
TEAMS_NOTIFICATIONS_ENABLED=false
TEAMS_WEBHOOK_URL=
ZABBIX_NOTIFICATIONS_ENABLED=false
ZABBIX_TRAPPER_URL=
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_FROM_ADDRESS=
