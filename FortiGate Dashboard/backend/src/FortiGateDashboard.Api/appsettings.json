{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=fortigate_dashboard;Username=fortigate;Password=changeme"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-api-app-registration-client-id>",
    "Audience": "<your-api-app-registration-client-id>"
  },
  "FortiGateCloud": {
    "BaseUrl": "https://support.fortinet.com/ES/api/registration/v3",
    "TokenUrl": "https://customerapiauth.fortinet.com/api/v1/oauth/token/",
    "ClientId": "",
    "ClientSecret": "",
    "Username": "",
    "Password": "",
    "AdditionalAccounts": []
  },
  "Psirt": {
    "FeedUrl": "https://filestore.fortinet.com/fortiguard/rss/psirt.xml"
  },
  "FortiGateCloudResiliency": {
    "RetryCount": 3,
    "TimeoutSeconds": 30,
    "TotalTimeoutSeconds": 120,
    "MaxRetryAfterSeconds": 30,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "MaxConcurrentRequests": 4,
    "MaxQueuedRequests": 8,
    "TruncationWarningThreshold": 1000
  },
  "RateLimiting": {
    "General": { "PermitLimit": 120, "WindowSeconds": 60, "QueueLimit": 0 },
    "Sync": { "PermitLimit": 1, "WindowSeconds": 60, "QueueLimit": 0 },
    "Export": { "PermitLimit": 5, "WindowSeconds": 60, "QueueLimit": 0 }
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Notifications": {
    "Zabbix": {
      "Enabled": false,
      "TrapperUrl": "http://zabbix-server:10051",
      "Host": "fortigate-dashboard"
    },
    "Teams": {
      "Enabled": false,
      "WebhookUrl": ""
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "FromAddress": "",
      "ToAddresses": []
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
